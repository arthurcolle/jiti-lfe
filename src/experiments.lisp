(defpackage :image-agent/experiments
  (:use :cl)
  (:export :main :evolve :reverse-fixtures :make-reverse-world :check-sample :verify-reverse))
(in-package :image-agent/experiments)
(defparameter +goal+
  "Add a new function (reverse-string string) to this running Lisp world. Return a newly allocated string on every invocation containing the input's original extended grapheme clusters in reverse logical order. Preserve code points inside each original cluster, do not normalize, and never mutate the input. Support the empty string, emoji sequences, combining accents, supplementary characters, RTL/LTR scripts, and mixed text. Rendering still follows Unicode bidi rules. Preserve the demo program. Use your registered tools to inspect, define, execute, and check the function; continue until the caller-owned goals pass. Define only managed named DEFUNs (a PROGN of definitions is allowed). SBCL's built-in Unicode facilities are available. Do not replace or modify caller tests or IMAGE-AGENT family packages.")
(defvar *failure-number* 0)
(defun code-string (&rest codes) (map 'string #'code-char codes))
(defun reverse-fixtures ()
  "Explicit expectations, independent of model definitions and runtime segmentation."
  (list (list "empty" "" "")
        (list "ASCII" "Hello" "olleH")
        (list "emoji" "A🙂B" "B🙂A")
        (list "ZWJ and modifier" "A👩🏽‍💻B" "B👩🏽‍💻A")
        (list "family ZWJ" "x👨‍👩‍👧‍👦y" "y👨‍👩‍👧‍👦x")
        (list "flags" "A🇦🇺🇯🇵B" "B🇯🇵🇦🇺A")
        (list "odd regional indicators" "🇦🇺🇬" "🇬🇦🇺")
        (list "decomposed accent" (concatenate 'string "e" (code-string #x301) "x")
              (concatenate 'string "xe" (code-string #x301)))
        (list "leading combining mark" (concatenate 'string (code-string #x301) "a")
              (concatenate 'string "a" (code-string #x301)))
        (list "variation selector" "A✈️B" "B✈️A")
        (list "keycap" "A1️⃣B" "B1️⃣A")
        (list "Hangul Jamo" (code-string #x41 #x1100 #x1161 #x11A8 #x42)
              (code-string #x42 #x1100 #x1161 #x11A8 #x41))
        (list "Arabic" "مرحبا" "ابحرم")
        (list "Arabic accent" (code-string #x41 #x646 #x64E #x42)
              (code-string #x42 #x646 #x64E #x41))
        (list "Hebrew" "שלום" "םולש")
        (list "Hebrew accents" (code-string #x41 #x5E9 #x5B8 #x5C1 #x42)
              (code-string #x42 #x5E9 #x5B8 #x5C1 #x41))
        (list "mixed RTL/LTR" "abc שלום 123" "321 םולש cba")
        (list "supplementary" "A𝄞𐐀B" "B𐐀𝄞A")
        (list "CRLF" (code-string #x41 #xD #xA #x42) (code-string #x42 #xD #xA #x41))
        (list "directional isolates" (code-string #x2066 #x61 #x62 #x2069)
              (code-string #x2069 #x62 #x61 #x2066))
        (list "NUL" (code-string #x61 0 #x62) (code-string #x62 0 #x61))))
(defun original-clusters (text)
  ;; SBCL 2.6.8 signals an index error for GRAPHEMES on the empty string.
  (if (zerop (length text)) nil (sb-unicode:graphemes text)))
(defun expected-output (text)
  "Trusted generated-case oracle, using the runtime's UAX #29 boundary data."
  (let* ((clusters (original-clusters text)) (output (make-string (length text))) (position 0))
    (loop for index downfrom (1- (length clusters)) to 0
          for cluster = (nth index clusters) do
      (replace output cluster :start1 position)
      (incf position (length cluster)))
    output))
(defun input-string (text shape)
  (ecase shape
    (:simple (copy-seq text))
    (:adjustable (let ((array (make-array (+ 3 (length text)) :element-type 'character :initial-element #\!
                                           :adjustable t :fill-pointer (length text))))
                   (replace array text) array))
    (:displaced (let ((backing (concatenate 'string "!" text "!")))
                  (make-array (length text) :element-type 'character :displaced-to backing :displaced-index-offset 1)))))
(defun character-counts (text)
  (let ((counts (make-hash-table :test 'eql)))
    (loop for c across text do (incf (gethash c counts 0))) counts))
(defun same-contents-p (a b)
  (let ((counts (character-counts a)))
    (loop for c across b do (decf (gethash c counts 0)))
    (loop for count being the hash-values of counts always (zerop count))))
(defun check-sample (world text &key (shape :simple) (expected (expected-output text)))
  "Execute on the owning worker; test and restore even if a candidate signals or mutates."
  (let* ((checkpoint (funcall (image-agent:world-snapshot world)))
         (symbol (find-symbol "REVERSE-STRING" (image-agent:world-package world)))
         (argument (input-string text shape)) (before (copy-seq argument))
         (*standard-output* (make-broadcast-stream)) (*error-output* (make-broadcast-stream)))
    (unwind-protect
         (if (not (and symbol (fboundp symbol)))
             (list :passed nil :problem :undefined-function :input text :shape shape :expected expected)
             (handler-case
                 (let* ((function (symbol-function symbol))
                        (actual (funcall function argument))
                        (problem (cond ((not (stringp actual)) :not-a-string)
                                       ((not (string= argument before)) :input-mutated)
                                       ((eq actual argument) :input-returned)
                                       ((/= (length actual) (length text)) :length-changed)
                                       ((not (same-contents-p text actual)) :contents-changed)
                                       ((not (string= actual expected)) :wrong-order))))
                   (unless problem
                     (let* ((again-input (input-string text shape)) (again (funcall function again-input)))
                       (setf problem (cond ((not (string= again-input text)) :input-mutated)
                                           ((not (stringp again)) :not-a-string)
                                           ((or (eq again again-input) (eq again argument)) :input-returned)
                                           ((eq again actual) :result-reused)
                                           ((or (not (string= again expected)) (not (string= actual expected))) :wrong-order)))))
                   (list :passed (null problem) :problem problem :input text :shape shape :expected expected
                         :actual (if (stringp actual) (copy-seq actual) (image-agent::bounded actual))))
               (error () (list :passed nil :problem :candidate-signaled :input text :shape shape :expected expected))))
      (funcall (image-agent:world-restore world) checkpoint))))
(defun random-scalar ()
  (loop for n = (random #x110000) unless (<= #xD800 n #xDFFF) return (code-char n)))
(defun generate-sample ()
  (let ((pieces '("a" "🙂" "👩🏽‍💻" "👨‍👩‍👧‍👦" "🇦🇺" "🇬" "é" "✈️" "1️⃣" "شَ" "שָׁ" "각" "कِ")))
    (with-output-to-string (s)
      (dotimes (i (random 24))
        (case (random 4)
          (0 (write-string (nth (random (length pieces)) pieces) s))
          (1 (write-char (code-char (nth (random 13) '(0 10 13 #x301 #x200D #xFE0F #x1F1E6 #x1F1FA #x2066 #x2069 #x1100 #x1161 #x11A8))) s))
          (otherwise (write-char (random-scalar) s)))))))
(defun shrink-string (text fails-p &optional (limit 100))
  "Bounded deletion shrinking; never assumes cluster boundaries survive reversal."
  (let ((small text) (attempts 0))
    (loop for width = (max 1 (floor (length small) 2)) then (floor width 2) while (plusp width) do
      (loop with index = 0 while (<= (+ index width) (length small)) do
        (when (>= attempts limit) (return-from shrink-string (values small attempts)))
        (let ((candidate (concatenate 'string (subseq small 0 index) (subseq small (+ index width)))))
          (incf attempts)
          (if (funcall fails-p candidate) (setf small candidate) (incf index)))))
    (values small attempts)))
(defun readable-sources (world)
  (let ((*package* (image-agent:world-package world)) (*print-readably* t) (*print-circle* t)
        (*print-level* nil) (*print-length* nil))
    (mapcar #'prin1-to-string (getf (funcall (image-agent:world-observe world)) :definitions))))
(defun save-failure (world root sample seed cases)
  (multiple-value-bind (small attempts)
      (shrink-string (getf sample :input)
        (lambda (text) (not (getf (check-sample world text :shape (getf sample :shape)) :passed))))
    (let* ((file (merge-pathnames (format nil "counterexamples/failure-~d.sexp" (incf *failure-number*)) root))
           (result (check-sample world small :shape (getf sample :shape))))
      (ensure-directories-exist file)
      (with-open-file (out file :direction :output :if-exists :error :external-format :utf-8)
        (let ((*print-readably* t) (*print-circle* t) (*print-level* nil) (*print-length* nil))
          (write (list :version 1 :kind :unicode-reversal :generator-version 1 :seed seed :cases cases
                       :sbcl (lisp-implementation-version) :dependencies (uiop:read-file-string
                          (merge-pathnames "devenv.lock" (asdf:system-source-directory "image-agent/experiments")))
                       :original (getf sample :input) :input small :shape (getf sample :shape)
                       :failure-class (getf result :problem) :shrink-attempts attempts
                       :result result :definitions (readable-sources world)) :stream out)))
      (namestring file))))
(defun verify-reverse (world &key (seed 424242) (cases 1000) artifacts)
  "Caller-owned acceptance; result reports fixed expectations plus seeded generation."
  (let ((results nil) (failure nil) (generated 0) (artifact nil))
    (dolist (fixture (reverse-fixtures))
      (destructuring-bind (name input expected) fixture
        (let ((result (check-sample world input :expected expected)))
          (push (list* :name name result) results)
          (unless (getf result :passed) (unless failure (setf failure result))))))
    (unless failure
      (let ((*random-state* (sb-ext:seed-random-state seed)))
        (loop repeat cases do
          (let* ((text (generate-sample)) (shape (nth (random 3) '(:simple :adjustable :displaced)))
                 (result (check-sample world text :shape shape)))
            (incf generated)
            (unless (getf result :passed) (setf failure result) (return))))))
    (when (and artifacts failure (not (eq (getf failure :problem) :undefined-function)))
      (setf artifact (save-failure world artifacts failure seed generated)))
    (list :property-result t :status (if failure :fail :pass) :seed seed :cases generated
          :fixed-cases (length results) :counterexample failure :artifact artifact :examples (nreverse results))))
(defun make-reverse-world (&key (seed 424242) (cases 1000) artifacts)
  (let* ((spec (image-agent/cli::demo-adapter)) (world (getf spec :world))
         (original (copy-tree (getf (funcall (image-agent:world-observe world)) :definitions)))
         (report (list nil)))
    (setf (getf spec :id) "unicode-reversal"
          (getf spec :goals)
          (list (cons :unicode-reversal
                      (lambda ()
                        (setf (car report) (verify-reverse world :seed seed :cases cases :artifacts artifacts))
                        ;; Detailed examples are kept for the user, not repeated in each model observation.
                        (let ((result (copy-list (car report)))) (remf result :examples) result))))
          (getf spec :invariants)
          (list (cons :demo-unchanged
                  (lambda ()
                    (let* ((table (image-agent:reference-table world))
                           (definitions (getf (funcall (image-agent:world-observe world)) :definitions))
                           (counter (find-symbol "COUNTER" (image-agent:world-package world))))
                      (and (= 1 (hash-table-count table)) (eql 0 (gethash :x table))
                           (every (lambda (form) (find form definitions :test #'equal)) original)
                           (fboundp counter) (eql 0 (funcall (symbol-function counter)))))))))
    (values spec report)))
(defun controller-action (controller action &rest fields)
  (apply #'image-agent/cli::controller-action controller
         (image-agent/cli::object "generation" (getf (image-agent/cli:controller-view controller) :generation)) action fields))
(defun evolve (controller chat goal &key (max-rounds 3) (output *standard-output*))
  "The Lisp controller prompts itself from its goal and observed caller-check failures."
  (unless (and (stringp goal) (plusp (length goal)) (integerp max-rounds) (plusp max-rounds)
               (getf (image-agent/cli:controller-view controller) :goals))
    (error "Evolution requires executable caller goals and a positive round budget"))
  (loop for round from 1 to max-rounds do
    (when (image-agent/cli::terminal-p (image-agent/cli:controller-view controller))
      (return-from evolve (list :status :failed :reason :worker-terminal :rounds (1- round))))
    (format output "~&Round ~d: Lisp is prompting OpenAI from its goal and caller checks.~%" round) (finish-output output)
    (let* ((*print-level* 8) (*print-length* 30)
           (prompt (if (= round 1) goal
                       (format nil "Continue the original goal: ~a~%The caller has not accepted completion. Current checks: ~s. Current state: ~a. Repair the failure using tools; model claims cannot substitute for these checks."
                         goal (getf (image-agent/cli:controller-view controller) :goals)
                         (getf (image-agent/cli:controller-view controller) :observation))))
           (reply (image-agent/cli:chat-turn chat prompt)))
      (format output "Model: ~a~%" (image-agent::bounded reply 1200)) (finish-output output))
    (unless (image-agent/cli::terminal-p (image-agent/cli:controller-view controller))
      (controller-action controller :check))
    (let ((view (image-agent/cli:controller-view controller)))
      (when (and (eq :idle (getf view :status)) (getf view :goals-achieved)
                 (image-agent::all-pass-p (getf view :goals)))
        (return-from evolve (list :status :success :rounds round :revision (getf view :revision)
                                 :remaining (getf view :remaining))))))
  (list :status :failed :reason :round-budget :rounds max-rounds))
(defun escaped-text (text)
  (if (not (stringp text)) (princ-to-string text)
      (with-output-to-string (s)
        (write-char #\" s)
        (loop for c across text for n = (char-code c) do
          (cond ((or (< n 32) (<= 127 n 159) (member n '(#x61C #x200E #x200F #x202A #x202B #x202C #x202D #x202E #x2066 #x2067 #x2068 #x2069)))
                 (format s "\\u{~4,'0x}" n))
                ((find c '(#\" #\\)) (write-char #\\ s) (write-char c s))
                (t (write-char c s))))
        (write-char #\" s))))
(defun code-points (text)
  (when (stringp text) (format nil "~{U+~4,'0x~^ ~}" (map 'list #'char-code text))))
(defun show-examples (report output)
  (dolist (example (getf report :examples))
    (format output "~&~a: ~a -> ~a; expected ~a [~a]~%  input: ~a~%  output: ~a~%"
            (getf example :name) (escaped-text (getf example :input)) (escaped-text (getf example :actual))
            (escaped-text (getf example :expected)) (if (getf example :passed) "PASS" "FAIL")
            (code-points (getf example :input)) (code-points (getf example :actual))))
  (format output "~&Caller checks: ~d fixed cases + ~d generated cases, seed ~d: ~a~%"
          (getf report :fixed-cases) (getf report :cases) (getf report :seed) (getf report :status)))
(defun fresh-verification (store seed cases output)
  (let ((script (merge-pathnames "scripts/experiment.lisp" (asdf:system-source-directory "image-agent/experiments"))))
    (multiple-value-bind (text errors status)
        (uiop:run-program (list (namestring (truename "/proc/self/exe")) "--noinform" "--script" (namestring script)
                               "--verify" (namestring store) "--seed" (princ-to-string seed) "--cases" (princ-to-string cases))
                          :output :string :error-output :string :ignore-error-status t)
      (declare (ignore errors))
      (write-string text output) (finish-output output)
      (unless (zerop status) (error "Fresh SBCL verification failed (exit ~d)" status)))))
(defun verify-store (store seed cases output)
  (multiple-value-bind (spec report) (make-reverse-world :seed seed :cases cases)
    (let* ((session (image-agent:recover-session (getf spec :world) store :interactive t :budget 100
                                               :goals (getf spec :goals) :invariants (getf spec :invariants)))
           (controller (image-agent/cli:make-controller session)))
      (unwind-protect
          (progn
            (unless (and (eq :idle (getf (image-agent/cli:controller-view controller) :status))
                         (getf (image-agent/cli:controller-view controller) :goals-achieved))
              (error "Recovered function failed caller checks"))
            (format output "Fresh SBCL recovered revision ~a: ~d fixed + ~d generated cases PASS.~%"
                    (getf (image-agent/cli:controller-view controller) :revision)
                    (getf (car report) :fixed-cases) (getf (car report) :cases)))
        (image-agent:close-session session)))))
(defun run-experiment (root seed cases output &key chat-factory (max-rounds 3))
  (when (image-agent::current-revision root) (error "Choose a fresh experiment store; existing revisions are preserved"))
  (image-agent/cli::ensure-workspace root "unicode-reversal")
  (multiple-value-bind (spec report) (make-reverse-world :seed seed :cases cases :artifacts root)
    (let* ((world (getf spec :world))
           (session (image-agent:make-session world :interactive t :store root :budget 100 :goal +goal+
                                             :goals (getf spec :goals) :invariants (getf spec :invariants)))
           (controller (image-agent/cli:make-controller session))
           (initial (getf (image-agent/cli:controller-view controller) :revision)) (result nil))
      (unwind-protect
          (progn
            (when (fboundp (intern "REVERSE-STRING" (image-agent:world-package world)))
              (error "Experiment requires an initially absent reverse-string"))
            (format output "~&Initial revision ~a: REVERSE-STRING is absent. SBCL ~a.~%" initial (lisp-implementation-version))
            (let ((chat (if chat-factory (funcall chat-factory controller)
                            (image-agent/cli:make-chat controller :tool-limit 20
                              :on-tool (lambda (name data)
                                (format output "~&tool ~a: ~a~%" name
                                  (or (and (hash-table-p data) (gethash "error" data))
                                      (and (hash-table-p data) (gethash "outcome" data)) "done"))
                                (finish-output output))))))
              (setf result (evolve controller chat +goal+ :max-rounds max-rounds :output output)))
            (unless (eq :success (getf result :status))
              (format output "~&Evolution FAILED: ~s. Caller checks: ~s~%" result
                      (getf (image-agent/cli:controller-view controller) :goals))
              (error "Evolution did not satisfy the caller-owned goal"))
            (show-examples (car report) output)
            (let* ((successful (getf result :revision)) (remaining (getf result :remaining))
                   (source-file (merge-pathnames "generated-source.lisp" root))
                   (state (image-agent::read-record (merge-pathnames (format nil "~a/world.sexp" successful) root))))
              (with-open-file (out source-file :direction :output :if-exists :error :external-format :utf-8)
                (format out "; Model-generated managed world definitions; review artifact, not a startup script.~%")
                (dolist (source (getf state :definitions)) (write-line source out)))
              (format output "~&Accepted revision: ~a. Model definitions: ~a~%" successful source-file)
              (image-agent:close-session session)
              (fresh-verification root seed cases output)
              (when (< remaining 3) (error "Worker budget cannot cover rollback/restoration proof"))
              (multiple-value-bind (fresh fresh-report) (make-reverse-world :seed seed :cases cases)
                (let* ((recovered (image-agent:recover-session (getf fresh :world) root :interactive t :budget remaining
                                      :goals (getf fresh :goals) :invariants (getf fresh :invariants)))
                       (control (image-agent/cli:make-controller recovered)))
                  (unwind-protect
                      (progn
                        (controller-action control :rollback :revision initial)
                        (unless (and (eq :idle (getf (image-agent/cli:controller-view control) :status))
                                     (eq :undefined-function (getf (getf (car fresh-report) :counterexample) :problem))
                                     (image-agent::all-pass-p (getf (image-agent/cli:controller-view control) :invariants)))
                          (error "Rollback did not remove the function and preserve the demo"))
                        (format output "Rollback to initial revision: function absent, demo intact PASS.~%")
                        (controller-action control :rollback :revision successful)
                        (unless (getf (image-agent/cli:controller-view control) :goals-achieved)
                          (error "Restored successful revision did not pass caller checks"))
                        (format output "Restored successful implementation into NEW revision ~a: PASS.~%"
                                (getf (image-agent/cli:controller-view control) :revision))
                        (setf (getf result :final-revision) (getf (image-agent/cli:controller-view control) :revision)))
                    (image-agent:close-session recovered))))
              (format output "~&EVOLUTION VERIFIED. Workspace: ~a~%" root)
              result))
        (image-agent:close-session session)))))
(defun replay (file output)
  (let ((record (image-agent::read-record file)))
    (unless (and (eql 1 (getf record :version)) (eq :unicode-reversal (getf record :kind)))
      (error "Unsupported counterexample artifact"))
    (multiple-value-bind (spec report) (make-reverse-world :cases 1)
      (declare (ignore report))
      (let* ((world (getf spec :world)) (last-result nil)
             (goals (list (cons :replay (lambda ()
                                          (setf last-result (check-sample world (getf record :input) :shape (getf record :shape)))
                                          (getf last-result :passed)))))
             (session (image-agent:make-session world :interactive t :goals goals))
             (control (image-agent/cli:make-controller session)))
        (unwind-protect
            (progn
              (controller-action control :evaluate :source (format nil "(progn ~{~a~%~})" (getf record :definitions)))
              (format output "Replay ~a: ~s~%" file last-result)
              (if (getf last-result :passed) :passed :reproduced))
          (image-agent:close-session session))))))
(defun options (args)
  (let ((result nil))
    (loop while args for flag = (pop args) do
      (when (equal flag "--help") (return-from options (list :help t)))
      (unless (and args (member flag '("--store" "--verify" "--replay" "--seed" "--cases") :test #'equal))
        (error "Use --store DIR, --seed INTEGER, --verify DIR, or --replay FILE"))
      (let ((value (pop args)))
        (setf (getf result (intern (string-upcase (subseq flag 2)) :keyword))
              (if (member flag '("--seed" "--cases") :test #'equal) (parse-integer value) value))))
    result))
(defun main (args)
  (let* ((options (options args)) (seed (or (getf options :seed) 424242)) (cases (or (getf options :cases) 1000)))
    (when (getf options :help)
      (format t "experiment-reverse [--store FRESH-DIR] [--seed INTEGER] | --replay FILE~%")
      (return-from main nil))
    (unless (and (integerp seed) (>= seed 0) (integerp cases) (plusp cases)) (error "Seed must be nonnegative and cases positive"))
    (when (and (getf options :cases) (not (getf options :verify))) (error "Live experiments always require 1000 cases"))
    (cond ((getf options :verify) (verify-store (image-agent::directory-path (getf options :verify)) seed cases *standard-output*))
          ((getf options :replay)
           (when (eq :reproduced (replay (getf options :replay) *standard-output*)) (sb-ext:exit :code 1)))
          (t
           (let* ((root (image-agent::directory-path (or (getf options :store)
                           (format nil ".image-agent/experiments/reverse-~d-~d/" (get-universal-time) (sb-posix:getpid)))))
                  (lock-path (merge-pathnames "workspace.lock" root)))
             (ensure-directories-exist lock-path)
             (with-open-file (lock lock-path :direction :output :if-exists :append :if-does-not-exist :create)
               (unless (zerop (image-agent/cli::workspace-flock (sb-sys:fd-stream-fd lock) 6)) (error "Workspace is in use"))
               (with-open-file (transcript (merge-pathnames "experiment.txt" root) :direction :output :if-exists :error :external-format :utf-8)
                 (run-experiment root seed cases (make-broadcast-stream *standard-output* transcript)))))))))
(sb-ext:lock-package :image-agent/experiments)
